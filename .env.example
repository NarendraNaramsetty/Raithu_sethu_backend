# ============================================================
# RaithuSetu Backend — Environment Variables Template
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to Git.
# ============================================================

# Django core
SECRET_KEY=your-django-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,testserver

# In production set DEBUG=False and lock down ALLOWED_HOSTS:
# DEBUG=False
# ALLOWED_HOSTS=your-backend.onrender.com,api.raithusetu.com

# Database (Neon PostgreSQL or leave blank to use SQLite in dev)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# CORS — comma-separated list of allowed frontend origins (production)
# Leave blank in local dev (all origins allowed when DEBUG=True)
CORS_ALLOWED_ORIGINS=https://your-frontend.vercel.app,https://raithusetu.com

# Anthropic Claude AI (Disease Detection)
Anthropic_Claude_API_Key=sk-ant-api03-your-key-here

# Government data API
DATA_GOV_IN_API_KEY=your-data-gov-in-key-here

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Gmail SMTP (OTP email login)
EMAIL_HOST_USER=youremail@gmail.com
EMAIL_HOST_PASSWORD=your-gmail-app-password
